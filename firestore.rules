rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Validation Helper
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'createdAt', 'streakCount', 'totalCo2SavedKg', 'xp', 'levelName', 'badges', 'weeklyGoalCo2', 'weeklyProgressCo2', 'completedChallengeIds'])
        && data.keys().size() <= 14
        && data.uid == request.auth.uid
        && data.createdAt == request.time
        && data.streakCount is int 
        && data.streakCount >= 0
        && (data.totalCo2SavedKg is int || data.totalCo2SavedKg is float)
        && data.totalCo2SavedKg >= 0
        && data.xp is int && data.xp >= 0
        && data.levelName is string && data.levelName in ['Eco Beginner', 'Green Explorer', 'Climate Warrior', 'Eco Hero', 'Planet Guardian']
        && data.badges is list
        && (data.weeklyGoalCo2 is int || data.weeklyGoalCo2 is float) && data.weeklyGoalCo2 >= 0
        && (data.weeklyProgressCo2 is int || data.weeklyProgressCo2 is float) && data.weeklyProgressCo2 >= 0
        && data.completedChallengeIds is list
        && (data.email == null || (data.email is string && data.email.size() <= 200))
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 150))
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && (data.lastActiveDate == null || (data.lastActiveDate is string && data.lastActiveDate.size() <= 20));
    }

    // Lifestyle Data Validation Helper
    function isValidLifestyleData(data) {
      return data.keys().hasAll([
          'uid', 'commuteMode', 'distancePerDayKm', 'annualFlights', 'dietType',
          'localFoodPercent', 'foodWasteLevel', 'electricityKwhPerMonth',
          'greenEnergyPercent', 'heatingType', 'shoppingHabits', 'recyclingLevel', 'updatedAt'
        ])
        && data.keys().size() <= 14
        && data.uid == request.auth.uid
        && data.updatedAt == request.time
        && data.commuteMode in ['car', 'public_transport', 'bike_walk', 'electric_car', 'hybrid_car']
        && (data.distancePerDayKm is int || data.distancePerDayKm is float) && data.distancePerDayKm >= 0 && data.distancePerDayKm <= 500
        && data.annualFlights is int && data.annualFlights >= 0 && data.annualFlights <= 1000
        && data.dietType in ['heavy_meat', 'occasional_meat', 'vegetarian', 'vegan']
        && (data.localFoodPercent is int || data.localFoodPercent is float) && data.localFoodPercent >= 0 && data.localFoodPercent <= 100
        && data.foodWasteLevel in ['high', 'medium', 'low']
        && (data.electricityKwhPerMonth is int || data.electricityKwhPerMonth is float) && data.electricityKwhPerMonth >= 0 && data.electricityKwhPerMonth <= 50000
        && (data.greenEnergyPercent is int || data.greenEnergyPercent is float) && data.greenEnergyPercent >= 0 && data.greenEnergyPercent <= 100
        && data.heatingType in ['gas', 'electric', 'coal_oil', 'district_solar', 'none']
        && (data.thermostatOffsetC == null || ((data.thermostatOffsetC is int || data.thermostatOffsetC is float) && data.thermostatOffsetC >= -10 && data.thermostatOffsetC <= 10))
        && data.shoppingHabits in ['high_consumer', 'moderate', 'minimalist']
        && data.recyclingLevel in ['none', 'some', 'full'];
    }

    // Recommendation Validation Helper
    function isValidRecommendation(data) {
      return data.keys().hasAll([
          'id', 'uid', 'title', 'description', 'category', 'co2SavedKgPerYear',
          'difficulty', 'personalizedReasoning', 'actionItems', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().size() <= 13
        && data.uid == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.description is string && data.description.size() <= 1000
        && data.category in ['Transport', 'Diet', 'Energy', 'Consumption']
        && (data.co2SavedKgPerYear is int || data.co2SavedKgPerYear is float) && data.co2SavedKgPerYear >= 0
        && data.difficulty in ['easy', 'medium', 'hard']
        && data.personalizedReasoning is string && data.personalizedReasoning.size() <= 3000
        && data.actionItems is list && data.actionItems.size() <= 20
        && data.status in ['active', 'completed', 'dismissed']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Impact Log Validation Helper
    function isValidImpactLog(data) {
      return data.keys().hasAll(['id', 'uid', 'recommendationId', 'recommendationTitle', 'category', 'co2SavedKg', 'loggedAt'])
        && data.keys().size() <= 7
        && data.uid == request.auth.uid
        && data.id is string && data.id.size() <= 128
        && data.recommendationId is string && data.recommendationId.size() <= 128
        && data.recommendationTitle is string && data.recommendationTitle.size() <= 200
        && data.category in ['Transport', 'Diet', 'Energy', 'Consumption']
        && (data.co2SavedKg is int || data.co2SavedKg is float) && data.co2SavedKg >= 0
        && data.loggedAt == request.time;
    }

    // Users Collection rules
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(request.resource.data);
      
      allow update: if isOwner(userId) && isValidId(userId) 
        && isValidUserProfile(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          // Action 1: Generic update / streak update / engagement updates
          request.resource.data.diff(resource.data).affectedKeys().hasAny(['streakCount', 'totalCo2SavedKg', 'lastActiveDate', 'displayName', 'photoURL', 'xp', 'levelName', 'badges', 'weeklyGoalCo2', 'weeklyProgressCo2', 'completedChallengeIds'])
        );
        
      allow delete: if false; // User accounts are durable cannot be deleted from client

      // Subcollection: Lifestyle habits
      match /lifestyle/{lifestyleId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(lifestyleId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(lifestyleId) && isValidLifestyleData(request.resource.data);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(lifestyleId)
          && isValidLifestyleData(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && (
            request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'commuteMode', 'distancePerDayKm', 'annualFlights', 'dietType',
              'localFoodPercent', 'foodWasteLevel', 'electricityKwhPerMonth',
              'greenEnergyPercent', 'heatingType', 'thermostatOffsetC',
              'shoppingHabits', 'recyclingLevel', 'updatedAt'
            ])
          );
        allow delete: if false;
      }

      // Subcollection: Recommendations
      match /recommendations/{recId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(recId);
        allow list: if isOwner(userId) && isValidId(userId);
        
        // Allowed to write recommendations if created properly
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(recId) 
          && isValidRecommendation(request.resource.data)
          && request.resource.data.createdAt == request.time;
          
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(recId)
          && isValidRecommendation(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            // Users primarily change status ('completed' | 'dismissed')
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          );
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(recId);
      }

      // Subcollection: Cumulative log entries
      match /impact_logs/{logId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
        allow list: if isOwner(userId) && isValidId(userId);
        
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(logId)
          && isValidImpactLog(request.resource.data)
          // Atomicity guarantee: Make sure user also updates user record's total carbon accumulator synchronously in the same batch/transaction
          && existsAfter(/databases/$(database)/documents/users/$(userId));
          
        allow update: if false; // Impact records are ledger entries, immutable after logging
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      }

      // Subcollection: Coach chats persistent history
      match /coach_chats/{msgId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(msgId)
          && request.resource.data.keys().hasAll(['id', 'uid', 'sender', 'text', 'createdAt'])
          && request.resource.data.keys().size() <= 5
          && request.resource.data.uid == userId
          && request.resource.data.sender in ['user', 'coach']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 8000
          && (request.resource.data.createdAt is string || request.resource.data.createdAt is timestamp);
        allow update, delete: if isOwner(userId) && isValidId(userId) && isValidId(msgId);
      }
    }
  }
}
